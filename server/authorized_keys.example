# Laptop key: ONLY for the dedicated reach-tunnel account.
# sshd-reach.conf MUST also be installed; key options alone do not prohibit sessions.
no-pty,no-agent-forwarding,no-X11-forwarding,no-user-rc,permitlisten="127.0.0.1:2203" ssh-ed25519 YOUR_LAPTOP_TUNNEL_PUBLIC_KEY reach-tunnel

# Cloud jump key: ONLY for a DIFFERENT reach-jump account.
no-pty,no-agent-forwarding,no-X11-forwarding,no-user-rc,permitopen="127.0.0.1:2203" ssh-ed25519 YOUR_CLOUD_JUMP_PUBLIC_KEY reach-jump
